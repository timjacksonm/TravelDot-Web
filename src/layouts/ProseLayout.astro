---
import BaseLayout from "./BaseLayout.astro";

// Markdown pages pass their frontmatter here; .astro pages pass the same shape.
interface Props {
  frontmatter: {
    title: string;
    description: string;
  };
}

const { title, description } = Astro.props.frontmatter;
---

<BaseLayout title={title} description={description}>
  <article class="wrap">
    <div class="prose">
      <h1>{title}</h1>
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  article {
    padding-top: 2.5rem;
  }

  h1 {
    font-size: clamp(2.25rem, 6vw, 3rem);
    margin-bottom: 1.5rem;
  }

  /* Markdown output isn't part of this component, so its styles need :global. */
  .prose :global(h2) {
    font-size: 1.375rem;
    margin-top: 2.5rem;
  }

  .prose :global(ul) {
    padding-left: 1.25rem;
  }

  .prose :global(li) {
    margin-bottom: 0.4rem;
  }
</style>
