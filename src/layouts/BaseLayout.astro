---
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import Lockup from "../components/Lockup.astro";

interface Props {
  // Page name for the browser tab, e.g. "Privacy". The home page passes the full title instead.
  title?: string;
  fullTitle?: string;
  description: string;
  current?: "home" | "support" | "other";
  glow?: "home" | "page";
  // Token pages and the 404 have nothing worth indexing.
  noindex?: boolean;
}

const { title, fullTitle, description, current = "other", glow, noindex = false } = Astro.props;

const pageTitle = fullTitle ?? (title ? `${title} · TravelDot` : "TravelDot");
const waitlistHref = current === "home" ? "#waitlist" : "/#waitlist";
const year = new Date().getFullYear();

const socials = [
  {
    name: "Facebook",
    icon: "facebook",
    href: "https://www.facebook.com/profile.php?id=61591517877112",
  },
  { name: "Instagram", icon: "instagram", href: "https://www.instagram.com/traveldotapp/" },
  { name: "X", icon: "x", href: "https://x.com/TravelDotApp" },
  { name: "YouTube", icon: "youtube", href: "https://www.youtube.com/@TravelDotApp" },
] as const;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <div class:list={["page", glow && `glow-${glow}`]}>
      <header class="site-header wrap">
        <a class="brand" href="/" aria-label="TravelDot home">
          <Lockup width={190} />
        </a>
        <nav class="header-nav" aria-label="Main">
          <a
            class="nav-link"
            href="/support"
            aria-current={current === "support" ? "page" : undefined}
          >
            Support
          </a>
          <a class="btn btn-primary" href={waitlistHref}>
            Join the waitlist
          </a>
        </nav>
      </header>

      <slot />

      <footer class="site-footer wrap">
        <div class="rule"></div>
        <div class="footer-main">
          <span class="footer-meta">© {year} TravelDot. All rights reserved.</span>
          <nav class="footer-nav" aria-label="Footer">
            <a class="footer-link" href="/privacy">
              Privacy Policy
            </a>
            <ul class="socials">
              {socials.map((s) => (
                <li>
                  <a href={s.href} aria-label={`TravelDot on ${s.name}`}>
                    <Icon name={s.icon} />
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </footer>
    </div>
  </body>
</html>

<style>
  .page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--color-bg);
  }

  .glow-home {
    background:
      radial-gradient(900px 560px at 12% -10%, var(--td-glow), transparent 70%), var(--color-bg);
  }

  .glow-page {
    background:
      radial-gradient(800px 480px at 10% 0%, var(--td-glow), transparent 70%), var(--color-bg);
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding-block: 18px;
  }

  .brand {
    display: flex;
    color: var(--color-text);
    text-decoration: none;
  }

  .site-header .brand {
    padding: 6px 0;
  }

  .header-nav {
    display: flex;
    align-items: center;
    gap: 22px;
  }

  .nav-link {
    color: inherit;
    text-decoration: none;
    font-size: 15px;
    padding: 10px 0;
  }

  .nav-link:hover,
  .nav-link[aria-current="page"] {
    color: var(--color-accent);
  }

  .site-footer {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-top: 40px;
    padding-bottom: 36px;
  }

  .footer-main {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 8px 24px;
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 24px;
    font-size: 15px;
  }

  .footer-nav a {
    color: var(--td-soft);
    text-decoration: none;
  }

  .footer-nav a:hover {
    color: var(--color-accent);
  }

  .footer-link {
    padding: 8px 0;
  }

  .socials {
    display: flex;
    list-style: none;
    margin: 0 -13px 0 0;
    padding: 0;
  }

  /* 44px hit targets around 18px icons. */
  .socials a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    font-size: 18px;
  }

  .footer-meta {
    font-size: 13px;
    color: var(--td-muted);
  }
</style>
