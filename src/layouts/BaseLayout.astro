---
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import Lockup from "../components/Lockup.astro";

interface Props {
  // Page name for the browser tab, e.g. "Privacy". The home page passes the full title instead.
  title?: string;
  fullTitle?: string;
  description: string;
  current?: "home" | "support" | "other";
  glow?: "home" | "page";
  // Token pages and the 404 have nothing worth indexing.
  noindex?: boolean;
}

const { title, fullTitle, description, current = "other", glow, noindex = false } = Astro.props;

const pageTitle = fullTitle ?? (title ? `${title} · TravelDot` : "TravelDot");
const waitlistHref = current === "home" ? "#waitlist" : "/#waitlist";
const year = new Date().getFullYear();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <div class:list={["page", glow && `glow-${glow}`]}>
      <header class="site-header wrap">
        <a class="brand" href="/" aria-label="TravelDot home">
          <Lockup width={190} />
        </a>
        <nav class="header-nav" aria-label="Main">
          <a
            class="nav-link"
            href="/support"
            aria-current={current === "support" ? "page" : undefined}
          >
            Support
          </a>
          <a class="btn btn-primary" href={waitlistHref}>
            Join the waitlist
          </a>
        </nav>
      </header>

      <slot />

      <footer class="site-footer wrap">
        <div class="rule"></div>
        <div class="footer-main">
          <a class="brand" href="/" aria-label="TravelDot home">
            <Lockup width={170} />
          </a>
          <nav class="footer-nav" aria-label="Footer">
            <a href="/support">Support</a>
            <a href="/privacy">Privacy</a>
            <a href={waitlistHref}>Waitlist</a>
          </nav>
        </div>
        <div class="footer-meta">
          <span>© {year} TravelDot · traveldot.app</span>
          <span>Coming to iPhone and Android</span>
        </div>
      </footer>
    </div>
  </body>
</html>

<style>
  .page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--color-bg);
  }

  .glow-home {
    background:
      radial-gradient(900px 560px at 12% -10%, var(--td-glow), transparent 70%), var(--color-bg);
  }

  .glow-page {
    background:
      radial-gradient(800px 480px at 10% 0%, var(--td-glow), transparent 70%), var(--color-bg);
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding-block: 18px;
  }

  .brand {
    display: flex;
    color: var(--color-text);
    text-decoration: none;
  }

  .site-header .brand {
    padding: 6px 0;
  }

  .header-nav {
    display: flex;
    align-items: center;
    gap: 22px;
  }

  .nav-link {
    color: inherit;
    text-decoration: none;
    font-size: 15px;
    padding: 10px 0;
  }

  .nav-link:hover,
  .nav-link[aria-current="page"] {
    color: var(--color-accent);
  }

  .site-footer {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-top: 40px;
    padding-bottom: 36px;
  }

  .footer-main {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    font-size: 15px;
  }

  .footer-nav a {
    color: var(--td-soft);
    text-decoration: none;
    padding: 8px 0;
  }

  .footer-nav a:hover {
    color: var(--color-accent);
  }

  .footer-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    font-size: 13px;
    color: var(--td-muted);
  }
</style>
