---
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import monoLatin from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url";
import Icon from "../components/Icon.astro";
import Lockup from "../components/Lockup.astro";

interface Props {
  // Page name for the browser tab, e.g. "Privacy". The home page passes the full title instead.
  title?: string;
  fullTitle?: string;
  description: string;
  current?: "home" | "support" | "other";
  glow?: "home" | "page";
  // Token pages and the 404 have nothing worth indexing.
  noindex?: boolean;
  // The waitlist pages hide the header's join button: those visitors already joined or are leaving.
  waitlistButton?: boolean;
}

const {
  title,
  fullTitle,
  description,
  current = "other",
  glow,
  noindex = false,
  waitlistButton = true,
} = Astro.props;

const pageTitle = fullTitle ?? (title ? `${title} · TravelDot` : "TravelDot");
const waitlistHref = current === "home" ? "#waitlist" : "/#waitlist";
const year = new Date().getFullYear();

// Social links are hidden for now. To show them, uncomment this and the list in the footer.
// const socials = [
//   {
//     name: "Facebook",
//     icon: "facebook",
//     href: "https://www.facebook.com/profile.php?id=61591517877112",
//   },
//   { name: "Instagram", icon: "instagram", href: "https://www.instagram.com/traveldotapp/" },
//   { name: "X", icon: "x", href: "https://x.com/TravelDotApp" },
//   { name: "YouTube", icon: "youtube", href: "https://www.youtube.com/@TravelDotApp" },
// ] as const;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <script is:inline>
      // Runs before first paint so a saved theme never flashes the other one.
      try {
        const saved = localStorage.getItem("theme");
        if (saved === "light" || saved === "dark") document.documentElement.dataset.theme = saved;
      } catch {
        // Storage blocked: follow the system theme.
      }
    </script>
  </head>
  <body>
    <div class:list={["page", glow && `glow-${glow}`]}>
      <header class="site-header wrap">
        <a class="brand" href="/" aria-label="TravelDot home">
          <Lockup width={190} />
        </a>
        <nav class="header-nav" aria-label="Main">
          <a
            class="nav-link"
            href="/support"
            aria-current={current === "support" ? "page" : undefined}
          >
            Support
          </a>
          {waitlistButton && (
            <a class="btn btn-primary" href={waitlistHref}>
              Join the waitlist
            </a>
          )}
          <button
            class="theme-toggle"
            type="button"
            aria-label="Switch to light mode"
            data-theme-toggle
          >
            <Icon name="ph-sun" class="theme-sun" />
            <Icon name="ph-moon" class="theme-moon" />
          </button>
        </nav>
      </header>

      <slot />

      <footer class="site-footer wrap">
        <div class="rule"></div>
        <div class="footer-main">
          <span class="footer-meta">© {year} TravelDot. All rights reserved.</span>
          <nav class="footer-nav" aria-label="Footer">
            <a class="footer-link" href="/privacy">
              Privacy Policy
            </a>
            {/*
            <ul class="socials">
              {socials.map((s) => (
                <li>
                  <a href={s.href} aria-label={`TravelDot on ${s.name}`}>
                    <Icon name={s.icon} />
                  </a>
                </li>
              ))}
            </ul>
            */}
          </nav>
        </div>
      </footer>
    </div>
  </body>
</html>

<script>
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]")!;
  const systemLight = window.matchMedia("(prefers-color-scheme: light)");

  const current = () => root.dataset.theme ?? (systemLight.matches ? "light" : "dark");
  const label = () =>
    toggle.setAttribute("aria-label", `Switch to ${current() === "dark" ? "light" : "dark"} mode`);

  toggle.addEventListener("click", () => {
    const next = current() === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch {
      // Private browsing can block storage; the switch still works for this page.
    }
    label();
  });
  systemLight.addEventListener("change", label);
  label();
</script>

<style>
  .page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--color-bg);
  }

  .glow-home {
    background:
      radial-gradient(900px 560px at 12% -10%, var(--td-glow), transparent 70%), var(--color-bg);
  }

  .glow-page {
    background:
      radial-gradient(800px 480px at 10% 0%, var(--td-glow), transparent 70%), var(--color-bg);
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding-block: 18px;
  }

  /* Stack before the row gets tight, so the header never wraps differently once fonts load. */
  @media (max-width: 600px) {
    .site-header {
      flex-direction: column;
      justify-content: center;
      gap: 6px;
    }

    .header-nav {
      align-self: flex-end;
    }
  }

  .brand {
    display: flex;
    color: var(--color-text);
    text-decoration: none;
  }

  .site-header .brand {
    padding: 6px 0;
  }

  .header-nav {
    display: flex;
    align-items: center;
    gap: 22px;
  }

  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    /* The 44px hit area overhangs the 20px icon, so pull it back to keep the visible spacing even. */
    margin: 0 -11px 0 -12px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--td-soft);
    font-size: 20px;
    cursor: pointer;
  }

  .theme-toggle:hover {
    color: var(--color-accent);
  }

  /* Dark shows the sun (switch to light); light shows the moon. */
  .theme-toggle :global(.theme-moon) {
    display: none;
  }

  :global(:root[data-theme="light"]) .theme-toggle :global(.theme-sun) {
    display: none;
  }

  :global(:root[data-theme="light"]) .theme-toggle :global(.theme-moon) {
    display: inline-block;
  }

  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme="dark"])) .theme-toggle :global(.theme-sun) {
      display: none;
    }

    :global(:root:not([data-theme="dark"])) .theme-toggle :global(.theme-moon) {
      display: inline-block;
    }
  }

  .nav-link {
    color: inherit;
    text-decoration: none;
    font-size: 15px;
    padding: 10px 0;
  }

  .nav-link:hover,
  .nav-link[aria-current="page"] {
    color: var(--color-accent);
  }

  .site-footer {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-top: 40px;
    padding-bottom: 36px;
  }

  .footer-main {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 8px 24px;
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 24px;
    font-size: 15px;
  }

  .footer-nav a {
    color: var(--td-soft);
    text-decoration: none;
  }

  .footer-nav a:hover {
    color: var(--color-accent);
  }

  .footer-link {
    padding: 8px 0;
  }

  .socials {
    display: flex;
    list-style: none;
    margin: 0 -13px 0 0;
    padding: 0;
  }

  /* 44px hit targets around 18px icons. */
  .socials a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    font-size: 18px;
  }

  .footer-meta {
    font-size: 13px;
    color: var(--td-muted);
  }
</style>
