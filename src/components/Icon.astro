---
import { faFacebook, faInstagram, faXTwitter, faYoutube } from "@fortawesome/free-brands-svg-icons";
import {
  faEnvelope,
  faMoon,
  faSun,
  faThumbsDown,
  faThumbsUp,
} from "@fortawesome/free-regular-svg-icons";
import type { IconDefinition } from "@fortawesome/free-solid-svg-icons";
import {
  faBan,
  faCarBurst,
  faCheck,
  faChevronDown,
  faChevronRight,
  faChevronUp,
  faCircleInfo,
  faCloud,
  faLocationArrow,
  faSnowflake,
  faSnowplow,
  faVolumeLow,
  faXmark,
} from "@fortawesome/free-solid-svg-icons";
import msDirections from "@material-symbols/svg-400/outlined/directions.svg?raw";
import msHistory from "@material-symbols/svg-400/outlined/history.svg?raw";
import msRainy from "@material-symbols/svg-400/outlined/rainy.svg?raw";
import msThunderstormFill from "@material-symbols/svg-400/outlined/thunderstorm-fill.svg?raw";
import msWeatherMix from "@material-symbols/svg-400/outlined/weather_mix.svg?raw";
import msWeatherSnowy from "@material-symbols/svg-400/outlined/weather_snowy.svg?raw";

// The app's icon set (TravelDot-Mobile src/components/ui/icon.tsx), under the same keys.

type Shape = {
  /** The glyph's own box as min-x, min-y, width, height. */
  box: [number, number, number, number];
  fills: string[];
  evenOdd?: boolean[];
  transform?: string;
  strokes?: { width: number; paths: string[] };
};

const fa = ({ icon: [width, height, , , path] }: IconDefinition): Shape => ({
  box: [0, 0, width, height],
  fills: Array.isArray(path) ? path : [path],
});

// Material Symbols draw in the middle 800 of a 960 grid, so the box crops that margin.
const ms = (svg: string): Shape => ({
  box: [80, -880, 800, 800],
  fills: [...svg.matchAll(/<path d="([^"]+)"/g)].map((m) => m[1]),
});

const icons = {
  "fa:ban": fa(faBan),
  "fa:car-burst": fa(faCarBurst),
  "fa:check": fa(faCheck),
  "fa:chevron-down": fa(faChevronDown),
  "fa:chevron-right": fa(faChevronRight),
  "fa:chevron-up": fa(faChevronUp),
  "fa:circle-info": fa(faCircleInfo),
  "fa:cloud": fa(faCloud),
  "fa:location-arrow": fa(faLocationArrow),
  "fa:snowflake": fa(faSnowflake),
  "fa:snowplow": fa(faSnowplow),
  "fa:volume-low": fa(faVolumeLow),
  "fa:xmark": fa(faXmark),
  "fa-regular:envelope": fa(faEnvelope),
  "fa-regular:moon": fa(faMoon),
  "fa-regular:sun": fa(faSun),
  "fa-regular:thumbs-down": fa(faThumbsDown),
  "fa-regular:thumbs-up": fa(faThumbsUp),
  "fa-brands:facebook": fa(faFacebook),
  "fa-brands:instagram": fa(faInstagram),
  "fa-brands:x-twitter": fa(faXTwitter),
  "fa-brands:youtube": fa(faYoutube),
  "ms:directions": ms(msDirections),
  "ms:history": ms(msHistory),
  "ms:rainy": ms(msRainy),
  "ms:thunderstorm-fill": ms(msThunderstormFill),
  "ms:weather_mix": ms(msWeatherMix),
  "ms:weather_snowy": ms(msWeatherSnowy),
  // No library has this one; it's the app's custom drawing of a car from behind, sliding.
  "custom:ice": {
    box: [0, 0, 512, 512],
    transform: "rotate(-8 256 190)",
    evenOdd: [true],
    fills: [
      "M168 30 H344 C362 30 376 40 382 56 L408 136 H416 C442 136 462 156 462 182 V248 C462 266 448 280 430 280 H82 C64 280 50 266 50 248 V182 C50 156 70 136 96 136 H104 L130 56 C136 40 150 30 168 30 Z " +
        "M178 62 C170 62 164 67 161 74 L144 122 H368 L351 74 C348 67 342 62 334 62 Z " +
        "M92 178 H160 C168 178 172 184 170 191 L166 206 C164 213 158 218 150 218 H92 Z " +
        "M420 178 H352 C344 178 340 184 342 191 L346 206 C348 213 354 218 362 218 H420 Z " +
        "M212 222 H300 V252 H212 Z",
      "M78 270 H150 V318 C150 330 140 340 128 340 H100 C88 340 78 330 78 318 Z",
      "M362 270 H434 V318 C434 330 424 340 412 340 H384 C372 340 362 330 362 318 Z",
    ],
    strokes: {
      width: 26,
      paths: [
        "M146 362 C176 377.9 162.7 391.5 132.7 407.3 C102.7 423.2 89.3 436.8 119.3 452.7 C149.3 468.5 136 482.1 106 498",
        "M280 352 C310 369 295.3 383.6 265.3 400.7 C235.3 417.7 220.7 432.3 250.7 449.3 C280.7 466.4 266 481 236 498",
        "M414 334 C444 353.1 428 369.5 398 388.7 C368 407.8 352 424.2 382 443.3 C412 462.5 396 478.9 366 498",
      ],
    },
  },
} satisfies Record<string, Shape>;

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  /** Draw at 5/6 of 1em, centered, like the app's Glyph. Without it the icon fills 1em, like RouteGlyph. */
  padded?: boolean;
  class?: string;
}

const { name, padded = false, class: className } = Astro.props;
const shape: Shape = icons[name];
const [x, y, width, height] = shape.box;
const margin = padded ? height / 10 : 0;
const viewBox = [x - margin, y - margin, width + 2 * margin, height + 2 * margin].join(" ");
---

<svg class:list={["icon", className]} viewBox={viewBox} aria-hidden="true" focusable="false">
  <g transform={shape.transform}>
    {shape.fills.map((d, i) => (
      <path d={d} fill-rule={shape.evenOdd?.[i] ? "evenodd" : undefined} />
    ))}
  </g>
  {shape.strokes?.paths.map((d) => (
    <path
      d={d}
      fill="none"
      stroke="currentColor"
      stroke-width={shape.strokes!.width}
      stroke-linecap="round"
    />
  ))}
</svg>
