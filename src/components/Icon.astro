const rawSvgs: Record<string, string> = {
  ...materialSymbols,
  "ph-caret-down": phCaretDown,
  "ph-check": phCheck,
  "ph-envelope": phEnvelope,
  "ph-info": phInfo,
  "ph-moon": phMoon,
  "ph-sun": phSun,
};

export type IconName = keyof typeof fontAwesome | keyof typeof rawSvgs;

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;

let viewBox: string;
let paths: string[];

const fa = fontAwesome[name];
if (fa) {
  const [width, height, , , path] = fa.icon;
  viewBox = `0 0 ${width} ${height}`;
  paths = Array.isArray(path) ? path : [path];
} else {
  const raw = rawSvgs[name];
  if (!raw) throw new Error(`Unknown icon: ${name}`);
  viewBox = raw.match(/viewBox="([^"]+)"/)![1];
  paths = [...raw.matchAll(/<path d="([^"]+)"/g)].map((m) => m[1]);
}
---

<svg class:list={["icon", className]} viewBox={viewBox} aria-hidden="true" focusable="false">
  {paths.map((d) => (
    <path d={d} />
  ))}
</svg>
