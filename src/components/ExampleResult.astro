---
// A static copy of the app's result screen, showing the app's sample check (Grand Rapids to
// Virginia). The data is copied word for word from the mobile repo's src/dev/sample-check.ts, which
// is the source: change it there first, then here. It's invented, not live data.
//
// The layout, sizes and colors follow the app's components (src/components/result in the mobile
// repo), so a change to the app's result screen should land here too.
import Icon, { type IconName } from "./Icon.astro";

// The route's length in miles. Every mark on the route line sits at mile / MILES along it.
const MILES = 58;
const along = (mile: number) => (mile / MILES) * 100;

type Hour = [temperature: number, chance: number, snowInches: number];

interface Place {
  id: string;
  name: string;
  temperature: number;
  forecast: string;
  // What the hourly forecast says is falling while snow is, before it turns to rain.
  snowingAs: string;
  hours: Hour[];
}

// The forecast starts at 8 AM, the time the sample check ran.
const places: Place[] = [
  {
    id: "origin",
    name: "Grand Rapids, MN",
    temperature: 30,
    forecast: "Rain and snow · 10 mph NW",
    snowingAs: "Rain and snow",
    hours: [
      [30, 60, 0.1],
      [30, 60, 0.1],
      [31, 55, 0.1],
      [31, 50, 0.1],
      [32, 45, 0.1],
      [32, 40, 0.1],
      [32, 40, 0],
      [31, 45, 0],
      [30, 50, 0],
      [29, 55, 0],
      [28, 60, 0],
      [27, 65, 0],
    ],
  },
  {
    id: "destination",
    name: "Virginia, MN",
    temperature: 25,
    forecast: "Heavy snow · 16 mph NW",
    snowingAs: "Snow",
    hours: [
      [25, 90, 0.4],
      [25, 90, 0.4],
      [24, 85, 0.3],
      [24, 85, 0.3],
      [25, 80, 0.3],
      [25, 75, 0.2],
      [24, 70, 0.2],
      [24, 70, 0.2],
      [23, 75, 0.2],
      [22, 75, 0.3],
      [21, 80, 0.3],
      [20, 80, 0.3],
    ],
  },
];

/** "Now", then "9a", "10a", "12p". */
function hourLabel(index: number) {
  if (index === 0) return "Now";
  const hour = 8 + index;
  return `${hour % 12 === 0 ? 12 : hour % 12}${hour < 12 ? "a" : "p"}`;
}

// The app picks an hour's icon from the forecast's words, first match wins. Only the three the
// sample needs are here.
function forecastIcon(words: string): IconName {
  if (/(rain|drizzle).*snow|snow.*(rain|drizzle)/i.test(words)) return "ms:weather_mix";
  if (/snow/i.test(words)) return "ms:weather_snowy";
  return "ms:rainy";
}

const alert = {
  event: "Winter Weather Advisory",
  window: "5:00 AM to 4:00 PM",
  description:
    "* WHAT...Snow and blowing snow expected. Additional snow accumulations of 2 to 4 inches.\n\n" +
    "* WHERE...Itasca and St. Louis counties.\n\n* WHEN...Until 4 PM CDT this afternoon.\n\n" +
    "* IMPACTS...Plan on slippery road conditions. Blowing snow could significantly reduce " +
    "visibility.",
  instruction:
    "Slow down and use caution while traveling. The latest road conditions for Minnesota can be " +
    "obtained by calling 5 1 1.",
  near: "Near Grand Rapids, MN",
};

interface Row {
  icon: IconName;
  title: string;
  note?: string;
  // Split on " · " so a line only breaks between parts, as in the app.
  detail: string[];
}

// The app draws "Wet pavement and slush" and "Reduced visibility, blowing snow" with the snowflake:
// it checks for snow or slush before wet or visibility.
const conditions: Row[] = [
  {
    icon: "fa:snowflake",
    title: "Wet pavement and slush",
    detail: ["Mile 2–12", "US-169", "northbound, southbound"],
  },
  {
    icon: "custom:ice",
    title: "Ice on roadway",
    detail: ["Mile 13–31", "US-169", "northbound, southbound"],
  },
  {
    icon: "fa:snowflake",
    title: "Snow-covered roadway",
    detail: ["Mile 32–43", "US-169", "northbound, southbound"],
  },
  {
    icon: "fa:snowflake",
    title: "Reduced visibility, blowing snow",
    detail: ["Mile 43–58", "US-169", "northbound"],
  },
];

// How many rows a section shows before "Show all".
const PREVIEW_ROWS = 3;

const activeIncidents: Row[] = [
  {
    icon: "fa:car-burst",
    title: "US-169: Crash reported",
    note: "right lane blocked",
    detail: ["Mile 36", "northbound"],
  },
];

const clearedIncidents: Row[] = [
  {
    icon: "fa:car-burst",
    title: "US-169: Vehicle spun out",
    detail: ["Mile 18", "northbound", "Cleared 7:30 AM"],
  },
];

const advisories: Row[] = [
  {
    icon: "fa:snowplow",
    title: "US-169: Snowplow activity",
    detail: ["Mile 28–42", "northbound, southbound"],
  },
  {
    icon: "ms:thunderstorm-fill",
    title: "US-169: Reduced visibility",
    detail: ["Mile 43–58", "northbound"],
  },
];

// Condition stretches on the route line, one per reported stretch.
const stretches = [
  [2, 12],
  [13, 31],
  [32, 43],
  [43, 58],
].map(([start, end]) => ({ left: along(start), width: along(end) - along(start) }));

// Above the line, one icon per condition. Touching stretches with the same icon share one, so
// the two snowflakes from mile 32 to 58 draw as a single mark in the middle of that span.
const conditionMarks: [start: number, end: number, IconName][] = [
  [2, 12, "fa:snowflake"],
  [13, 31, "custom:ice"],
  [32, 58, "fa:snowflake"],
];

// Below the line, one icon per event at its mile: incidents in red, everything else grey.
const eventMarks: [mile: number, IconName, incident: boolean][] = [
  [28, "fa:snowplow", false],
  [36, "fa:car-burst", true],
  [43, "ms:thunderstorm-fill", false],
];
---

<figure class="result" aria-label="Example of a trip check result">
  <div class="frame-label">
    <span>Example result</span>
    <span>Illustration, not live</span>
  </div>

  <div class="from-to">
    <div class="from-to-top">
      <div class="rail" aria-hidden="true">
        <div class="dot-origin"></div>
        <div class="rail-line"></div>
        <div class="dot-destination">
          <div></div>
        </div>
      </div>
      <div class="places">
        <div>
          <div class="caption muted-3">From</div>
          <div class="sheet-title">Grand Rapids, MN</div>
        </div>
        <div>
          <div class="caption muted-3">To</div>
          <div class="sheet-title">Virginia, MN</div>
        </div>
      </div>
    </div>
    <div class="from-to-footer">
      <div class="footer-glyph">
        <Icon name="ms:history" padded />
      </div>
      <div class="subtitle muted-3">Checked 8:00 AM · road data as of 7:42 AM</div>
    </div>
  </div>

  <h3 class="section-header">Summary</h3>
  <div class="card">
    <p class="body summary-text">
      Wet snow and slush are reported on US-169 leaving Grand Rapids, with ice on the roadway
      through the middle of the route. A vehicle that spun out near mile 18 was cleared at 7:30 AM.
      A crash is reported near mile 36 northbound, with the right lane blocked. Heavier snow,
      blowing snow and reduced visibility are reported approaching Virginia. A Winter Weather
      Advisory is in effect until 4 PM.
    </p>
    <div class="listen" aria-hidden="true">
      <Icon name="fa:volume-low" padded />
      <span>Listen</span>
    </div>
    <div class="feedback">
      <div class="feedback-text">
        <span class="caption muted-4">Generated by AI</span>
        <span class="subtitle muted-3">Was this summary helpful?</span>
      </div>
      <div class="thumb" aria-hidden="true">
        <Icon name="fa-regular:thumbs-up" padded />
      </div>
      <div class="thumb" aria-hidden="true">
        <Icon name="fa-regular:thumbs-down" padded />
      </div>
    </div>
  </div>

  <h3 class="section-header">Weather</h3>
  <div
    class="card alert"
    role="button"
    tabindex="0"
    aria-expanded="false"
    aria-label="Winter Weather Advisory, show details"
    data-alert
  >
    <div class="alert-kicker muted-3">Weather alert</div>
    <div class="row-title strong">{alert.event}</div>
    <div class="subtitle muted-2">{alert.window}</div>
    <div class="subtitle muted-2 alert-text alert-description">{alert.description}</div>
    <div class="alert-more" hidden>
      <div class="subtitle strong alert-text">What to do</div>
      <div class="subtitle muted-2">{alert.instruction}</div>
    </div>
    <div class="caption muted-3 alert-text">{alert.near}</div>
    <div class="caption tint alert-text" data-alert-label>
      Show details
    </div>
  </div>

  <div class="pair">
    {places.map((place) => (
      <div
        class="card anchor"
        role="button"
        tabindex="0"
        aria-expanded="false"
        aria-controls={`hourly-${place.id}`}
        aria-label={`Show hourly forecast for ${place.name}`}
        data-anchor={place.id}
      >
        <div class="caption muted-3 one-line">{place.name} · Now</div>
        <div class="temperature">{place.temperature}°</div>
        <div class="subtitle muted-2 one-line" data-fit>
          {place.forecast}
        </div>
        <div class="preview">
          {place.hours.slice(1, 5).map(([temperature], i) => (
            <div>
              <span class="caption muted-3">{hourLabel(i + 1)}</span>
              <span class="subtitle strong">{temperature}°</span>
            </div>
          ))}
        </div>
        <div class="forecast-link">
          <span>Hourly forecast</span>
          <Icon name="fa:chevron-down" class="when-closed" padded />
          <Icon name="fa:chevron-up" class="when-open" padded />
        </div>
      </div>
    ))}
  </div>

  {places.map((place) => (
    <div
      id={`hourly-${place.id}`}
      class="card hourly"
      role="region"
      aria-label={`${place.name} · Next ${place.hours.length} hours`}
      hidden
    >
      <div class="hourly-header">
        <span class="row-title strong">
          {place.name} · Next {place.hours.length} hours
        </span>
        <button type="button" class="hourly-close" aria-label="Close hourly forecast" data-close>
          <Icon name="fa:xmark" padded />
        </button>
      </div>
      <div class="hours">
        {place.hours.map(([temperature, chance, snow], i) => (
          <div class="hour">
            <span class="caption muted-3">{hourLabel(i)}</span>
            <Icon
              name={forecastIcon(snow > 0 ? place.snowingAs : "Rain")}
              class="hour-glyph"
              padded
            />
            <span class="subtitle strong">{temperature}°</span>
            <span class="caption tint">{chance}%</span>
            <span class="caption muted-2">{snow > 0 ? `${snow.toFixed(1)}″` : " "}</span>
          </div>
        ))}
      </div>
      <div class="caption muted-3">Bottom row: snowfall each hour, in inches.</div>
    </div>
  ))}

  <h3 class="section-header">Route</h3>
  <div class="card route">
    <div class="route-names">
      <span>Grand Rapids, MN</span>
      <span>Virginia, MN</span>
    </div>
    <div class="route-line" aria-hidden="true">
      <div class="dot-origin"></div>
      <div class="track-area">
        <div class="track"></div>
        {stretches.map(({ left, width }) => (
          <div class="stretch" style={`left:${left}%; width:${width}%`} />
        ))}
        {conditionMarks.map(([start, end, icon]) => (
          <div class="pin above" style={`left:${(along(start) + along(end)) / 2}%`}>
            <div class="pin-glyph">
              <Icon name={icon} />
            </div>
            <div class="connector" />
          </div>
        ))}
        {eventMarks.map(([mile, icon, incident]) => (
          <div class:list={["pin below", { incident }]} style={`left:${along(mile)}%`}>
            <div class="connector" />
            <div class="pin-glyph">
              <Icon name={icon} />
            </div>
          </div>
        ))}
      </div>
      <div class="dot-destination">
        <div></div>
      </div>
    </div>
    <div class="separator"></div>
    <div class="roads">
      <div class="caption muted-3 roads-label">Roads checked</div>
      <div class="shield-row">
        <span class="shield">US-169</span>
        <Icon name="fa:chevron-right" class="roads-chevron" padded />
      </div>
      <div class="sheet-note muted-3">58 miles · 1 hr 6 min</div>
    </div>
    <div class="separator"></div>
    <div class="directions">
      <span class="directions-icon">
        <Icon name="ms:directions" padded />
      </span>
      <span class="directions-label">View driving directions</span>
      <Icon name="fa:chevron-right" class="directions-chevron" padded />
    </div>
  </div>

  <h3 class="section-header">Conditions</h3>
  <div class="group">
    {conditions.map((row, i) => (
      <div class="row" hidden={i >= PREVIEW_ROWS} data-folded={i >= PREVIEW_ROWS}>
        <span class="row-glyph tint">
          <Icon name={row.icon} />
        </span>
        <div class="row-body">
          <span class="row-title">{row.title}</span>
          <span class="subtitle muted-3">
            {row.detail.map((part, j) => (
              <span class="part">{j < row.detail.length - 1 ? `${part} · ` : part}</span>
            ))}
          </span>
        </div>
      </div>
    ))}
    <div class="row fold" role="button" tabindex="0" aria-expanded="false" data-fold>
      <span class="row-title tint" data-fold-label>
        Show all {conditions.length} conditions
      </span>
      <Icon name="fa:chevron-right" class="fold-chevron" padded />
    </div>
  </div>

  <h3 class="section-header">Incidents</h3>
  <div class="group">
    {activeIncidents.map((row) => (
      <div class="row">
        <span class="row-glyph danger">
          <Icon name={row.icon} />
        </span>
        <div class="row-body">
          <span class="row-title">{row.title}</span>
          {row.note && <span class="subtitle muted-2">{row.note}</span>}
          <span class="subtitle muted-3">
            {row.detail.map((part, j) => (
              <span class="part">{j < row.detail.length - 1 ? `${part} · ` : part}</span>
            ))}
          </span>
        </div>
      </div>
    ))}
    {clearedIncidents.map((row) => (
      <div class="row">
        <span class="row-glyph muted-3">
          <Icon name={row.icon} />
        </span>
        <div class="row-body">
          <span class="row-title muted-2">{row.title}</span>
          <span class="subtitle muted-3">
            {row.detail.map((part, j) => (
              <span class="part">{j < row.detail.length - 1 ? `${part} · ` : part}</span>
            ))}
          </span>
        </div>
        <span class="cleared">Cleared</span>
      </div>
    ))}
  </div>

  <h3 class="section-header">Advisories</h3>
  <div class="group">
    {advisories.map((row) => (
      <div class="row">
        <span class="row-glyph muted-2">
          <Icon name={row.icon} />
        </span>
        <div class="row-body">
          <span class="row-title">{row.title}</span>
          <span class="subtitle muted-3">
            {row.detail.map((part, j) => (
              <span class="part">{j < row.detail.length - 1 ? `${part} · ` : part}</span>
            ))}
          </span>
        </div>
      </div>
    ))}
  </div>

  <div class="continue" aria-hidden="true">
    <Icon name="fa:location-arrow" padded />
    <span>Continue to Google Maps</span>
  </div>

  <p class="footnote muted-3">Conditions can change. Drive according to current road conditions.</p>
</figure>

<script>
  // The parts of the app's result screen a visitor can open and close here.
  function onActivate(el: HTMLElement, fn: () => void) {
    el.addEventListener("click", fn);
    el.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        fn();
      }
    });
  }

  function toggled(el: HTMLElement) {
    const open = el.getAttribute("aria-expanded") !== "true";
    el.setAttribute("aria-expanded", String(open));
    return open;
  }

  // The weather alert shows two lines of the NWS text until it's opened.
  const alert = document.querySelector<HTMLElement>("[data-alert]")!;
  onActivate(alert, () => {
    const open = toggled(alert);
    alert.querySelector<HTMLElement>(".alert-more")!.hidden = !open;
    alert.querySelector<HTMLElement>("[data-alert-label]")!.textContent = open
      ? "Show less"
      : "Show details";
  });

  // Each weather card opens its hourly forecast below the pair; only one is open at a time.
  const anchors = [...document.querySelectorAll<HTMLElement>("[data-anchor]")];
  function openHourly(id: string | null) {
    for (const anchor of anchors) {
      const open = anchor.dataset.anchor === id;
      anchor.setAttribute("aria-expanded", String(open));
      document.getElementById(`hourly-${anchor.dataset.anchor}`)!.hidden = !open;
    }
  }
  for (const anchor of anchors) {
    onActivate(anchor, () =>
      openHourly(anchor.getAttribute("aria-expanded") === "true" ? null : anchor.dataset.anchor!),
    );
  }
  for (const close of document.querySelectorAll<HTMLElement>("[data-close]")) {
    close.addEventListener("click", () => openHourly(null));
  }

  // The app shrinks a weather card's forecast line to fit, down to 80% of its size, before it
  // cuts the line off. Done here in script because CSS can't size text to its own width.
  const forecasts = [...document.querySelectorAll<HTMLElement>("[data-fit]")];
  function fitForecasts() {
    for (const line of forecasts) {
      let size = 13;
      line.style.fontSize = `${size}px`;
      while (line.scrollWidth > line.clientWidth && size - 0.2 >= 10.4) {
        size -= 0.2;
        line.style.fontSize = `${size}px`;
      }
    }
  }
  fitForecasts();
  new ResizeObserver(fitForecasts).observe(document.querySelector(".pair")!);

  // Conditions show three rows, then fold the rest behind "Show all".
  const fold = document.querySelector<HTMLElement>("[data-fold]")!;
  const foldLabel = fold.querySelector<HTMLElement>("[data-fold-label]")!;
  const foldLabelClosed = foldLabel.textContent;
  onActivate(fold, () => {
    const open = toggled(fold);
    for (const row of document.querySelectorAll<HTMLElement>("[data-folded='true']")) {
      row.hidden = !open;
    }
    foldLabel.textContent = open ? "Show fewer conditions" : foldLabelClosed;
  });
</script>

<style>
  /* The app's colors (constants/theme.ts in the mobile repo), dark first like the site. */
  .result {
    --ground: #0a1418;
    --surface: #1c1c1e;
    --label: #ffffff;
    --label-2: #d1d1d6;
    --label-3: #a1a1a6;
    --label-4: #8e8e93;
    --separator: #38383a;
    --tint: #2bc6e0;
    --tint-solid: #0a7488;
    --tint-wash: rgba(43, 198, 224, 0.12);
    --track: rgba(43, 198, 224, 0.32);
    --fill: rgba(120, 120, 128, 0.24);
    --danger: #ff6b52;
    --brand-ink: #e9e9ed;
    --brand-accent: #2bc6e0;
    /* iOS separates dark cards by fill, not shadow. */
    --card-shadow: none;
    --hairline: 1px;
  }

  :global(:root[data-theme="light"]) .result {
    --ground: #eaf3f6;
    --surface: #ffffff;
    --label: #1c1c1e;
    --label-2: #3c3c43;
    --label-3: #6c6c70;
    --label-4: #8e8e93;
    --separator: #e5e5ea;
    --tint: #0a7488;
    --tint-wash: rgba(10, 116, 136, 0.1);
    --track: rgba(10, 116, 136, 0.28);
    --fill: rgba(120, 120, 128, 0.13);
    --danger: #c02a10;
    --brand-ink: #161826;
    --brand-accent: #0e8fa6;
    --card-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
  }

  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme="dark"])) .result {
      --ground: #eaf3f6;
      --surface: #ffffff;
      --label: #1c1c1e;
      --label-2: #3c3c43;
      --label-3: #6c6c70;
      --label-4: #8e8e93;
      --separator: #e5e5ea;
      --tint: #0a7488;
      --tint-wash: rgba(10, 116, 136, 0.1);
      --track: rgba(10, 116, 136, 0.28);
      --fill: rgba(120, 120, 128, 0.13);
      --danger: #c02a10;
      --brand-ink: #161826;
      --brand-accent: #0e8fa6;
      --card-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
    }
  }

  /* The app draws separators one device pixel thin. */
  @media (min-resolution: 2dppx) {
    .result {
      --hairline: 0.5px;
    }
  }

  @media (min-resolution: 3dppx) {
    .result {
      --hairline: 0.34px;
    }
  }

  .result {
    margin: 0;
    min-width: 0;
    padding: 16px 0;
    border-radius: 24px;
    background: var(--ground);
    color: var(--label);
    box-shadow: var(--shadow-md);
    /* The app uses the phone's own font: SF Pro on iPhone, Roboto on Android. */
    font-family: -apple-system, BlinkMacSystemFont, system-ui, "Segoe UI", Roboto, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  .frame-label {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding: 0 20px 16px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--label-3);
  }

  /* The app's type scale (constants/design.ts). */
  .caption {
    font-size: 12px;
    line-height: 16px;
  }

  .subtitle {
    font-size: 13px;
    line-height: 17.5px;
  }

  .row-title {
    font-size: 16px;
    line-height: 21px;
  }

  .body {
    font-size: 16px;
    line-height: 24px;
  }

  .sheet-title {
    font-size: 20px;
    line-height: 25px;
    font-weight: 600;
    letter-spacing: -0.4px;
  }

  .sheet-note {
    font-size: 14px;
    line-height: 20px;
  }

  .alert-kicker {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.6px;
    text-transform: uppercase;
  }

  .strong {
    font-weight: 600;
  }

  .muted-2 {
    color: var(--label-2);
  }

  .muted-3 {
    color: var(--label-3);
  }

  .muted-4 {
    color: var(--label-4);
  }

  .tint {
    color: var(--tint);
  }

  .danger {
    color: var(--danger);
  }

  .one-line {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  [hidden] {
    display: none !important;
