---
// A static illustration of the app's result screen. None of it is live data.
import Icon, { type IconName } from "./Icon.astro";

interface Place {
  id: string;
  name: string;
  short: string;
  temp: number;
  summary: string;
  preview: [string, number][];
  hours: [string, number, number][];
}

const places: Place[] = [
  {
    id: "grand-rapids",
    name: "Grand Rapids, MN",
    short: "Grand Rapids",
    temp: 30,
    summary: "Rain and snow · 10 mph NW",
    preview: [
      ["9a", 30],
      ["10a", 31],
      ["11a", 31],
      ["12p", 32],
    ],
    hours: [
      ["Now", 30, 60],
      ["9a", 30, 60],
      ["10a", 31, 55],
      ["11a", 31, 50],
      ["12p", 32, 45],
      ["1p", 32, 40],
      ["2p", 32, 40],
      ["3p", 31, 45],
      ["4p", 30, 50],
      ["5p", 29, 55],
      ["6p", 28, 60],
      ["7p", 27, 65],
    ],
  },
  {
    id: "virginia",
    name: "Virginia, MN",
    short: "Virginia",
    temp: 25,
    summary: "Heavy snow · 16 mph NW",
    preview: [
      ["9a", 25],
      ["10a", 24],
      ["11a", 24],
      ["12p", 25],
    ],
    hours: [
      ["Now", 25, 90],
      ["9a", 25, 90],
      ["10a", 24, 85],
      ["11a", 24, 85],
      ["12p", 25, 80],
      ["1p", 25, 75],
      ["2p", 24, 70],
      ["3p", 24, 70],
      ["4p", 23, 75],
      ["5p", 22, 75],
      ["6p", 21, 80],
      ["7p", 20, 80],
    ],
  },
];

interface Row {
  icon: IconName;
  title: string;
  meta: string;
  muted?: boolean;
}

const conditions: Row[] = [
  {
    icon: "droplet",
    title: "US-169: Wet pavement and slush",
    meta: "Mile 2–12 · northbound, southbound",
  },
  {
    icon: "severe-cold",
    title: "US-169: Ice on roadway",
    meta: "Mile 13–31 · northbound, southbound",
  },
  {
    icon: "snowflake",
    title: "US-169: Snow-covered roadway",
    meta: "Mile 32–43 · northbound, southbound",
  },
  {
    icon: "eye-slash",
    title: "US-169: Reduced visibility, blowing snow",
    meta: "Mile 43–48 · northbound",
  },
];

const incidents: Row[] = [
  {
    icon: "car-burst",
    title: "US-169: Vehicle spun out",
    meta: "Mile 18 · northbound · Resolved 7:30 AM",
    muted: true,
  },
];

const advisories: Row[] = [
  {
    icon: "truck",
    title: "US-169: Snowplow activity",
    meta: "Mile 28–42 · northbound, southbound",
  },
  { icon: "circle-info", title: "US-169: Reduced visibility", meta: "Mile 43–48 · northbound" },
];

// Positions along the route line, as a percent of its length.
const segments = [
  [4, 21],
  [27, 38],
  [67, 22.5],
  [90.5, 9.5],
];
const above: [number, IconName][] = [
  [15, "droplet"],
  [46, "severe-cold"],
  [77, "snowflake"],
  [95, "eye-slash"],
];
const below: [number, IconName, boolean?][] = [
  [38, "car-burst", true],
  [73, "truck"],
  [95, "circle-info"],
];
---

<figure class="result" aria-label="Example of a trip check result">
  <div class="frame-label">
    <span>Example result</span>
    <span>Illustration, not live</span>
  </div>

  <div class="trip">
    <div class="trip-name">
      Grand Rapids, MN <Icon name="arrow-right" class="trip-arrow" /> Virginia, MN
    </div>
    <div class="share" aria-hidden="true">
      <Icon name="arrow-up-from-bracket" />
    </div>
  </div>

  <div class="group">
    <div class="checked">Checked 8:00 AM · road data as of 7:42 AM</div>
    <div class="card summary">
      <div class="summary-title">Slush leaving Grand Rapids, heavier snow near Virginia.</div>
      <p class="summary-text">
        Wet snow and slush are reported on US-169 leaving Grand Rapids, with ice on the roadway
        through the middle of the route. A vehicle that spun out near mile 18 was cleared at 7:30
        AM. Heavier snow, blowing snow and reduced visibility are reported approaching Virginia. A
        Winter Weather Advisory is in effect until 4 PM.
      </p>
      <div class="feedback">
        <div class="feedback-text">
          <span class="ai">Generated by AI</span>
          <span>Was this summary helpful?</span>
        </div>
        <button type="button" class="round" aria-label="Helpful">
          <Icon name="thumbs-up" />
        </button>
        <button type="button" class="round" aria-label="Not helpful">
          <Icon name="thumbs-down" />
        </button>
      </div>
    </div>
  </div>

  <div class="group">
    <div class="section-label">Weather</div>
    <div class="weather">
      <div class="card advisory">
        <div class="advisory-title">Winter Weather Advisory</div>
        <div>Snow and blowing snow expected.</div>
        <div>Itasca and St. Louis counties</div>
        <div>5:00 AM to 4:00 PM</div>
      </div>

      <div class="weather-cards">
        {places.map((place) => (
          <div
            class="card wx-card"
            role="button"
            tabindex="0"
            aria-label={`${place.name} weather, open the hourly forecast`}
            aria-expanded="false"
            aria-controls={`wx-${place.id}`}
            data-wx={place.id}
          >
            <div class="wx-where">{place.short} · Now</div>
            <div class="wx-temp">{place.temp}°</div>
            <div class="wx-summary">{place.summary}</div>
            <div class="wx-preview" aria-label="Hourly preview">
              <div class="wx-preview-hours">
                {place.preview.map(([t, temp]) => (
                  <div>
                    <span class="wx-time">{t}</span>
                    <span class="wx-preview-temp">{temp}°</span>
                  </div>
                ))}
              </div>
              <Icon name="chevron-right" class="wx-chevron" />
            </div>
          </div>
        ))}
      </div>

      {places.map((place) => (
        <div
          id={`wx-${place.id}`}
          class="card wx-panel"
          role="region"
          aria-label={`${place.name} · Next 12 hours`}
          hidden
        >
          <div class="wx-panel-head">
            <span>{place.name} · Next 12 hours</span>
            <button
              type="button"
              class="round small"
              aria-label="Close hourly forecast"
              data-wx-close
            >
              <Icon name="xmark" />
            </button>
          </div>
          <div class="wx-hours">
            {place.hours.map(([t, temp, pop]) => (
              <div class="wx-hour">
                <span class="wx-time">{t}</span>
                <Icon name={pop >= 50 ? "snowflake" : "cloud"} />
                <span class="wx-hour-temp">{temp}°</span>
                <span class="wx-pop">{pop}%</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="group">
    <div class="section-label">Route</div>
    <div class="card route">
      <div class="track">
        <div class="base"></div>
        {segments.map(([left, width]) => (
          <div class="segment" style={`left:${left}%; width:${width}%`} />
        ))}
        {above.map(([left, icon]) => (
          <div class="marker above" style={`left:${left}%`}>
            <div class="tick" />
            <div class="glyph">
              <Icon name={icon} />
            </div>
          </div>
        ))}
        {below.map(([left, icon, muted]) => (
          <div class="marker below" style={`left:${left}%`}>
            <div class="tick" />
            <div class:list={["glyph", { muted }]}>
              <Icon name={icon} />
            </div>
          </div>
        ))}
        <div class="origin"></div>
        <div class="destination">
          <div></div>
        </div>
      </div>
      <div class="ends">
        <span>Grand Rapids, MN</span>
        <span>Virginia, MN</span>
      </div>
      <div class="distance">48 miles · US-169</div>
    </div>
  </div>

  <div class="group">
    <div class="section-label">Conditions</div>
    <div class="card list">
      {conditions.map((row, i) => (
        <div class:list={["row", { extra: i === 3, divided: i < 2 }]} hidden={i === 3}>
          <div class="row-icon">
            <Icon name={row.icon} />
          </div>
          <div class="row-text">
            <span class="row-title">{row.title}</span>
            <span class="row-meta">{row.meta}</span>
          </div>
        </div>
      ))}
      <div class="more" role="button" tabindex="0" aria-expanded="false" data-more>
        <span data-more-label>Show all 4 conditions</span>
        <Icon name="chevron-down" class="more-down" />
        <Icon name="chevron-up" class="more-up" />
      </div>
    </div>
  </div>

  <div class="group">
    <div class="section-label">Incidents</div>
    <div class="card list">
      {incidents.map((row) => (
        <div class="row">
          <div class:list={["row-icon", { muted: row.muted }]}>
            <Icon name={row.icon} />
          </div>
          <div class="row-text">
            <span class="row-title">{row.title}</span>
            <span class="row-meta">{row.meta}</span>
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="group">
    <div class="section-label">Advisories</div>
    <div class="card list">
      {advisories.map((row, i) => (
        <div class:list={["row", { divided: i < advisories.length - 1 }]}>
          <div class="row-icon">
            <Icon name={row.icon} />
          </div>
          <div class="row-text">
            <span class="row-title">{row.title}</span>
            <span class="row-meta">{row.meta}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</figure>

<script>
  const cards = [...document.querySelectorAll<HTMLElement>("[data-wx]")];
  const panels = cards.map((card) => document.getElementById(`wx-${card.dataset.wx}`)!);

  function openWeather(id: string | null) {
    cards.forEach((card, i) => {
      const open = card.dataset.wx === id;
      card.setAttribute("aria-expanded", String(open));
      panels[i].hidden = !open;
    });
  }

  function onActivate(el: HTMLElement, fn: () => void) {
    el.addEventListener("click", fn);
    el.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        fn();
      }
    });
  }

  for (const card of cards) {
    onActivate(card, () =>
      openWeather(card.getAttribute("aria-expanded") === "true" ? null : card.dataset.wx!),
    );
  }
  for (const close of document.querySelectorAll<HTMLElement>("[data-wx-close]")) {
    close.addEventListener("click", () => openWeather(null));
  }

  const more = document.querySelector<HTMLElement>("[data-more]")!;
  const extra = document.querySelector<HTMLElement>(".row.extra")!;
  const moreLabel = more.querySelector<HTMLElement>("[data-more-label]")!;
  onActivate(more, () => {
    const expand = more.getAttribute("aria-expanded") !== "true";
    more.setAttribute("aria-expanded", String(expand));
    extra.hidden = !expand;
    moreLabel.textContent = expand ? "Show fewer" : "Show all 4 conditions";
  });
</script>

<style>
  .result {
    margin: 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 26px;
    padding: 24px 20px 28px;
    border-radius: 24px;
    background: color-mix(in srgb, var(--td-dot) 6%, var(--color-bg));
    box-shadow: var(--shadow-md);
  }

  .frame-label {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    padding: 0 4px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--td-muted);
  }

  .trip {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 4px;
  }

  .trip-name {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 7px;
    flex-wrap: wrap;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.2px;
  }

  .trip-name :global(.trip-arrow) {
    font-size: 14px;
    vertical-align: 0;
  }

  .share {
    width: 36px;
    height: 36px;
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 18px;
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    color: var(--color-accent);
    font-size: 14px;
  }

  .group {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .card {
    display: flex;
    flex-direction: column;
    border-radius: 14px;
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }

  .card[hidden],
  .row[hidden] {
    display: none;
  }

  .checked {
    font-size: 13px;
    color: var(--td-muted);
    padding: 0 4px;
  }

  .summary {
    gap: 12px;
    padding: 20px;
  }

  .summary-title {
    font-size: 22px;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.5px;
    text-wrap: balance;
  }

  .summary-text {
    font-size: 15px;
    line-height: 1.55;
    color: var(--td-soft);
  }

  .feedback {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
    padding-top: 14px;
    border-top: 1px solid var(--color-divider);
  }

  .feedback-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    font-size: 13px;
    line-height: 1.35;
    color: var(--td-soft);
  }

  .feedback-text .ai {
    font-size: 12px;
    color: var(--td-muted);
  }

  .round {
    width: 38px;
    height: 38px;
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 19px;
    background: color-mix(in srgb, var(--td-muted) 18%, transparent);
    color: var(--td-muted);
    font-size: 16px;
    cursor: pointer;
  }

  .round:hover {
    color: var(--color-accent);
  }

  .round.small {
    width: 32px;
    height: 32px;
    border-radius: 16px;
    font-size: 13px;
  }

  .section-label {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
    padding: 0 6px;
  }

  .weather {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .weather-cards {
    display: flex;
    gap: 12px;
  }

  .wx-card {
    flex: 1 1 0;
    min-width: 0;
    gap: 4px;
    padding: 16px;
    cursor: pointer;
    outline-offset: 2px;
  }

  .wx-card:hover {
    box-shadow: var(--shadow-md);
  }

  .wx-where {
    font-size: 12px;
    color: var(--td-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .wx-temp {
    font-size: 30px;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.4px;
  }

  .wx-summary {
    font-size: 13px;
    line-height: 1.35;
    color: var(--td-soft);
  }

  .wx-preview {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid var(--color-divider);
  }

  .wx-preview-hours {
    flex: 1;
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2px;
  }

  .wx-preview-hours > div {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
    min-width: 0;
  }

  .wx-time {
    font-size: 12px;
    color: var(--td-muted);
  }

  .wx-preview-temp {
    font-size: 14px;
    font-weight: 500;
  }

  .wx-preview :global(.wx-chevron) {
    font-size: 11px;
    color: var(--color-accent);
  }

  .wx-panel {
    gap: 12px;
    padding: 16px 0 14px;
  }

  .wx-panel-head {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 16px 0 18px;
  }

  .wx-panel-head span {
    flex: 1;
    min-width: 0;
    font-size: 15px;
    font-weight: 600;
  }

  .wx-hours {
    display: flex;
    gap: 4px;
    overflow-x: auto;
    padding: 0 14px 2px;
    scrollbar-width: thin;
  }

  .wx-hour {
    flex: 0 0 52px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    padding: 8px 0;
    border-radius: 10px;
    font-size: 14px;
  }

  .wx-hour-temp {
    font-size: 15px;
    font-weight: 500;
  }

  .wx-pop {
    font-size: 12px;
    color: var(--td-soft);
  }

  .advisory {
    gap: 4px;
    padding: 16px 18px;
    box-shadow: inset 0 0 0 1px var(--color-divider);
    font-size: 13px;
    line-height: 1.4;
    color: var(--td-soft);
  }

  .advisory-title {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.55;
    color: var(--color-text);
  }

  .route {
    gap: 12px;
    padding: 20px 22px 18px;
  }

  .track {
    position: relative;
    height: 84px;
    margin: 0 8px;
  }

  .base {
    position: absolute;
    left: 0;
    right: 0;
    top: 41px;
    height: 2px;
    border-radius: 1px;
    background: var(--td-rule);
  }

  .segment {
    position: absolute;
    top: 40px;
    height: 4px;
    border-radius: 2px;
    background: var(--td-dot);
  }

  .marker {
    position: absolute;
    width: 0;
    height: 34px;
  }

  .marker.above {
    top: 0;
  }

  .marker.below {
    bottom: 0;
  }

  .tick {
    position: absolute;
    left: -0.75px;
    width: 1.5px;
    height: 13px;
    background: var(--td-muted);
    opacity: 0.55;
  }

  .above .tick {
    bottom: 0;
  }

  .below .tick {
    top: 0;
  }

  .glyph {
    position: absolute;
    left: 0;
    transform: translateX(-50%);
    line-height: 1;
    font-size: 14px;
    display: flex;
  }

  .above .glyph {
    top: 0;
  }

  .below .glyph {
    bottom: 0;
  }

  /* Material Symbols carry padding inside their box, so they run a size up. */
  .glyph :global(.icon-ms) {
    font-size: 17px;
  }

  .muted {
    color: var(--td-muted);
  }

  .origin {
    position: absolute;
    left: -6px;
    top: 36px;
    width: 13px;
    height: 13px;
    border-radius: 50%;
    border: 4px solid var(--color-text);
    background: var(--color-surface);
  }

  .destination {
    position: absolute;
    right: -10px;
    top: 32px;
    width: 21px;
    height: 21px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .destination::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--td-dot);
    opacity: 0.18;
  }

  .destination div {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--td-dot);
  }

  .ends {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .distance {
    font-size: 13px;
    color: var(--td-muted);
  }

  .row {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    column-gap: 14px;
    align-items: center;
    padding: 14px 18px;
  }

  /* A divider sits under the text column, as in the app, so it starts at the text. */
  .row.divided .row-text {
    padding-bottom: 14px;
    margin-bottom: -14px;
    border-bottom: 1px solid var(--color-divider);
  }

  .row.extra {
    border-top: 1px solid var(--color-divider);
  }

  .row-icon {
    display: flex;
    justify-content: center;
    font-size: 16px;
  }

  .row-icon :global(.icon-ms) {
    font-size: 20px;
  }

  .row-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .row-title {
    font-size: 15px;
    line-height: 1.35;
  }

  .row-meta {
    font-size: 13px;
    line-height: 1.4;
    color: var(--td-muted);
  }

  .more {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 18px;
    border-top: 1px solid var(--color-divider);
    font-size: 15px;
    color: var(--color-accent);
    cursor: pointer;
    border-radius: 0 0 14px 14px;
  }

  .more:hover {
    background: color-mix(in srgb, var(--color-accent) 7%, transparent);
  }

  .more :global(.icon) {
    font-size: 12px;
    color: var(--td-muted);
  }

  .more :global(.more-up),
  .more[aria-expanded="true"] :global(.more-down) {
    display: none;
  }

  .more[aria-expanded="true"] :global(.more-up) {
    display: inline-block;
  }
</style>
