---
// Illustrative only: an example of what a trip check returns, not live data.
interface Stop {
  mile: string;
  title: string;
  detail?: string;
  endpoint?: boolean;
}

const stops: Stop[] = [
  { mile: "0", title: "Hibbing", endpoint: true },
  { mile: "4–11", title: "Snow-covered", detail: "Reported by a plow crew" },
  { mile: "20", title: "Crash, right lane blocked", detail: "Near Mountain Iron" },
  { mile: "25", title: "Virginia", endpoint: true },
];
---

<figure class="log">
  <figcaption>
    <span class="label">Example trip</span>
    <span class="route">Hibbing to Virginia on US-169</span>
  </figcaption>

  <p class="alert">
    <strong>Winter weather advisory</strong>
    <span>St. Louis County, the whole route</span>
  </p>

  <ol>
    {stops.map((stop) => (
      <li class:list={{ endpoint: stop.endpoint }}>
        <span class="mile">
          <span class="visually-hidden">Mile </span>
          {stop.mile}
        </span>
        <span class="marker" aria-hidden="true" />
        <span class="text">
          <strong>{stop.title}</strong>
          {stop.detail && <span>{stop.detail}</span>}
        </span>
      </li>
    ))}
  </ol>
</figure>

<style>
  .log {
    margin: 0;
    padding: 1.5rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 0.75rem;
  }

  figcaption {
    display: grid;
    margin-bottom: 1.25rem;
  }

  .label {
    color: var(--asphalt);
    font-size: 0.9375rem;
  }

  .route {
    font-weight: 800;
    font-size: 1.25rem;
  }

  .alert {
    display: grid;
    padding: 0.75rem 1rem;
    margin-bottom: 1.5rem;
    border-left: 4px solid var(--route);
    background: var(--snow);
  }

  .alert span,
  .text span {
    color: var(--asphalt);
    font-size: 0.9375rem;
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    display: grid;
    grid-template-columns: 3.5rem 1.5rem 1fr;
    gap: 0.75rem;
    min-height: 4.5rem;
  }

  li:last-child {
    min-height: 0;
  }

  .mile {
    text-align: right;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--asphalt);
  }

  /* The road: a line through every marker, stopping at the last one. */
  .marker {
    position: relative;
  }

  .marker::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 0.3rem;
    bottom: -0.3rem;
    width: 4px;
    margin-left: -2px;
    background: var(--line);
  }

  li:last-child .marker::before {
    display: none;
  }

  .marker::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 0.3rem;
    width: 1rem;
    height: 1rem;
    margin-left: -0.5rem;
    border-radius: 50%;
    background: var(--route);
  }

  .endpoint .marker::after {
    background: var(--surface);
    border: 4px solid var(--ink);
  }

  .text {
    display: grid;
    align-content: start;
    padding-bottom: 1rem;
  }
</style>
