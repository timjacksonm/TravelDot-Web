---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="There's no page at this address." noindex>
  <section class="wrap">
    <div class="prose">
      <h1>No page here</h1>
      <p>
        Check the address, or head to the <a href="/">home page</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  section {
    padding-top: 2.5rem;
  }
</style>
