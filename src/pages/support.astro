---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { APP_STORE_URL, GOOGLE_PLAY_URL } from "../lib/stores";

const faqs = [
  {
    q: "Where do I get it?",
    a: `On the <a href="${APP_STORE_URL}">App Store</a> for iPhone and on <a href="${GOOGLE_PLAY_URL}">Google Play</a> for Android.`,
    open: true,
  },
  { q: "Which phones will it work on?", a: "iPhone and Android." },
  {
    q: "What does a trip check show?",
    a: "Road conditions like ice, compacted snow and low visibility; incidents like crashes and stalled vehicles; advisories like closures and detours; and weather along the route. Each one shows the mile it starts at, the direction it affects, and when the data was last updated. There's also a plain-language summary of the whole drive.",
  },
  {
    q: "Will it tell me whether I should drive?",
    a: "No. TravelDot shows what's been reported along your route. It doesn't rate conditions, score your trip or tell you whether to go. That call stays with you.",
  },
  {
    q: "Where does the information come from?",
    a: "From official road and weather reporting. Every item in a trip check shows when it was last updated, so you can see how current it is.",
  },
  {
    q: "Does it work outside Minnesota?",
    a: "Not yet. TravelDot covers all of Minnesota.",
  },
  {
    q: "Is it free?",
    a: "Yes. A free account gets 5 trip checks a month. TravelDot Plus is $2.99 a month or $19.99 a year and adds unlimited checks, favorite trips, checking again from History, and trip summaries read aloud.",
  },
  {
    q: "How do I cancel TravelDot Plus?",
    a: "Plus is billed by Apple or Google, so you cancel it where you subscribed: in your Apple ID's Subscriptions on iPhone, or in Google Play's Payments & subscriptions on Android. You keep Plus until the end of the period you paid for.",
  },
  {
    q: "How do I delete my account?",
    a: `In the app, go to Account and choose Delete account. You can also <a href="/delete-account">ask us to delete it</a>.`,
  },
  {
    q: "How do I leave the waitlist?",
    a: "Use the unsubscribe link at the bottom of any email from us. If you can't find one, write to us and we'll remove you.",
  },
];
---

<BaseLayout
  title="Support"
  description="Answers about TravelDot, TravelDot Plus and your account."
  current="support"
>
  <main class="wrap">
    <div class="content">
      <div class="intro">
        <div class="kicker">Support</div>
        <h1>Answers about TravelDot.</h1>
        <p>
          Common questions about trip checks, TravelDot Plus and your account. Can't find yours? Get
          in touch.
        </p>
      </div>

      <div class="faqs">
        <div class="rule"></div>
        {faqs.map((faq) => (
          <>
            <details open={faq.open}>
              <summary>
                {faq.q}
                <Icon name="fa:chevron-down" class="caret" padded />
              </summary>
              <p set:html={faq.a} />
            </details>
            <div class="rule" />
          </>
        ))}
      </div>

      <div class="ask">
        <div class="ask-text">
          <div class="ask-title">Still have a question?</div>
          <div class="ask-sub">
            Write to <span class="mono">support@traveldot.app</span>
          </div>
        </div>
        <a class="btn btn-primary" href="mailto:support@traveldot.app">
          <Icon name="fa-regular:envelope" class="ask-icon" padded />
          Email support
        </a>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  main {
    flex: 1;
    padding-top: clamp(28px, 6vw, 72px);
    padding-bottom: 24px;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 40px;
    max-width: 760px;
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  h1 {
    font-size: clamp(36px, 5vw, 56px);
    line-height: 1.04;
    letter-spacing: -0.035em;
  }

  .intro p {
    font-size: 17px;
    line-height: 1.6;
    color: var(--td-soft);
    text-wrap: pretty;
  }

  .faqs {
    display: flex;
    flex-direction: column;
  }

  summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 0;
    cursor: pointer;
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary :global(.caret) {
    font-size: 18px;
    color: var(--td-muted);
    transition: transform 0.2s;
  }

  details[open] summary :global(.caret) {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    summary :global(.caret) {
      transition: none;
    }
  }

  details p {
    padding: 0 0 22px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--td-soft);
    max-width: 40em;
  }

  .ask {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
    padding: 22px 24px;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }

  .ask-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .ask-title {
    font-size: 18px;
    font-weight: 500;
  }

  .ask-sub {
    font-size: 15px;
    color: var(--td-soft);
    overflow-wrap: anywhere;
  }

  .ask-sub .mono {
    font-size: 14px;
    color: var(--color-text);
  }

  .ask :global(.ask-icon) {
    font-size: 17px;
  }
</style>
