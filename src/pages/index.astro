---
import BaseLayout from "../layouts/BaseLayout.astro";
import ExampleResult from "../components/ExampleResult.astro";
import Icon, { type IconName } from "../components/Icon.astro";
import MinnesotaMap from "../components/MinnesotaMap.astro";
import WaitlistForm from "../components/WaitlistForm.astro";

const shows: [IconName, string][] = [
  ["snowflake", "Road conditions: ice, snow, wet pavement, visibility"],
  [
    "car-burst",
    "Incidents: crashes, stalled vehicles, debris, including recently cleared incidents",
  ],
  ["ban", "Advisories: closures, lane closures, detours"],
  [
    "cloud",
    "Weather: conditions at your origin and destination, with an hourly forecast available for a closer look",
  ],
];
---

<BaseLayout
  fullTitle="TravelDot · Know before you go"
  description="Road conditions from official transportation feeds and reports, summarized in plain language so you know what to expect along your drive. Coming to iPhone and Android."
  current="home"
  glow="home"
>
  <main class="wrap">
    <section class="hero">
      <div class="kicker">Coming to iPhone and Android</div>
      <h1>Know what’s ahead before you hit the road.</h1>
      <p class="lede">
        Road conditions from official transportation feeds and reports, summarized in plain language
        so you know what to expect along your route.
      </p>
      <ul class="checks">
        <li>
          <Icon name="ph-check" />
          <span>One summary for your whole drive, not a map full of pins.</span>
        </li>
        <li>
          <Icon name="ph-check" />
          <span>Take your route into your preferred navigation app when you're ready to go.</span>
        </li>
      </ul>
      <WaitlistForm />
    </section>

    <div class="rule"></div>

    <section class="shows">
      <div class="shows-copy">
        <div class="shows-intro">
          <h2>What a trip check shows</h2>
          <p>
            Each report tells you what it is, where it was reported, which direction it affects, and
            when the information was last updated.
          </p>
        </div>
        <ul class="shows-list">
          {shows.map(([icon, text]) => (
            <li>
              <div class="shows-icon">
                <Icon name={icon} />
              </div>
              <span>{text}</span>
            </li>
          ))}
        </ul>
      </div>
      <ExampleResult />
    </section>

    <div class="rule"></div>

    <section class="minnesota">
      <div class="minnesota-copy">
        <h2>All of Minnesota. Built on the Iron Range.</h2>
        <p>
          TravelDot covers all of Minnesota at launch. It started on the Iron Range, where winter
          weather can change road conditions quickly and knowing what’s ahead matters.
        </p>
      </div>
      <MinnesotaMap />
    </section>

    <div class="rule"></div>

    <section class="contact">
      <h2>Contact TravelDot</h2>
      <p>
        Have a question, found something that looks off, or have an idea for a better trip check?
      </p>
      <a class="mono contact-email" href="mailto:support@traveldot.app">
        support@traveldot.app
      </a>
      <p class="contact-note">We’d love to hear from you.</p>
    </section>
  </main>
</BaseLayout>

<style>
  main {
    flex: 1;
  }

  .hero {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 680px;
    padding: clamp(40px, 9vw, 112px) 0 clamp(56px, 8vw, 104px);
  }

  h1 {
    font-size: clamp(40px, 6.4vw, 72px);
    line-height: 1.02;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  h2 {
    font-size: clamp(30px, 4vw, 44px);
    line-height: 1.08;
    letter-spacing: -0.03em;
  }

  .lede {
    font-size: clamp(18px, 1.8vw, 20px);
    line-height: 1.55;
    color: var(--td-soft);
    text-wrap: pretty;
  }

  .checks,
  .shows-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .checks {
    gap: 12px;
  }

  .checks li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-size: 17px;
    line-height: 1.45;
  }

  .checks :global(.icon) {
    font-size: 19px;
    margin-top: 2px;
    color: var(--color-accent);
  }

  .shows {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: 48px clamp(40px, 6vw, 80px);
    align-items: start;
    padding: clamp(56px, 8vw, 104px) 0;
  }

  .shows-copy {
    display: flex;
    flex-direction: column;
    gap: 28px;
    min-width: 0;
  }

  .shows-intro {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .shows-intro p,
  .minnesota-copy p,
  .contact p {
    font-size: 17px;
    line-height: 1.6;
    color: var(--td-soft);
    text-wrap: pretty;
  }

  .shows-list {
    gap: 18px;
  }

  .shows-list li {
    display: flex;
    gap: 14px;
    align-items: center;
    font-size: 17px;
  }

  .shows-icon {
    width: 36px;
    height: 36px;
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    font-size: 16px;
  }

  .minnesota {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr));
    gap: 40px clamp(40px, 6vw, 80px);
    align-items: center;
    padding: clamp(56px, 8vw, 104px) 0;
  }

  .minnesota-copy {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }

  .minnesota-copy h2 {
    text-wrap: balance;
  }

  .contact {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    max-width: 620px;
    padding: clamp(56px, 8vw, 96px) 0 clamp(32px, 4vw, 48px);
  }

  .contact h2 {
    font-size: clamp(26px, 3.2vw, 34px);
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .contact-email {
    font-size: clamp(17px, 2vw, 20px);
    text-decoration: none;
    padding: 6px 0;
    overflow-wrap: anywhere;
  }

  .contact p.contact-note {
    font-size: 15px;
    color: var(--td-muted);
  }
</style>
